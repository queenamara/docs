{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Arora",
  "description": "Arora connects Claude, ChatGPT, and the rest of your AI to the tools your business runs on. Same context, same rules, same memory, wherever you work.",
  "colors": {
    "primary": "#6B5EA8",
    "light": "#A69ECB",
    "dark": "#50477E"
  },
  "favicon": "/logo/arora-icon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "https://github.com/amarareps/bridge-mcp/issues"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "introduction",
          "quickstart",
          "connect-your-ai"
        ]
      },
      {
        "group": "Core Concepts",
        "icon": "layers",
        "expanded": true,
        "pages": [
          "concepts/command-center",
          "concepts/connectors",
          "concepts/missions",
          "concepts/plays",
          "concepts/templates"
        ]
      },
      {
        "group": "Connectors",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "connectors/overview",
          "connectors/clickup",
          "connectors/gmail",
          "connectors/google-calendar",
          "connectors/google-drive",
          "connectors/slack",
          "connectors/shopify",
          "connectors/hubspot"
        ]
      },
      {
        "group": "Account & Billing",
        "icon": "building-2",
        "expanded": true,
        "pages": [
          "account/organizations",
          "account/plans",
          "account/members"
        ]
      },
      {
        "group": "Troubleshooting",
        "icon": "life-buoy",
        "expanded": true,
        "pages": [
          "troubleshooting/faq",
          "troubleshooting/connector-issues"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/arora-wordmark-light.svg",
    "dark": "/logo/arora-wordmark-dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "href": "https://aroramcp.com",
        "label": "aroramcp.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Arora",
      "href": "https://app.aroramcp.com"
    }
  },
  "footer": {
    "socials": {}
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#EDE9F0",
      "dark": "#110F1A"
    }
  },
  "appearance": {
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Inter"
    }
  }
}
